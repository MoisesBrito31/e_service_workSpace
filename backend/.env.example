# Django Settings
DJANGO_SECRET_KEY=change-me-in-production-super-secret-key-12345
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (MySQL)
DB_ENGINE=django.db.backends.mysql
DB_NAME=eservice_db
DB_USER=eservice_user
DB_PASSWORD=eservice_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Object Storage Configuration (MinIO for dev, AWS S3 for prod)
USE_S3=True
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadminpassword
AWS_STORAGE_BUCKET_NAME=eservice-artefatos
AWS_S3_ENDPOINT_URL=http://127.0.0.1:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_S3_FILE_OVERWRITE=False
AWS_DEFAULT_ACL=None
AWS_QUERYSTRING_AUTH=False

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
